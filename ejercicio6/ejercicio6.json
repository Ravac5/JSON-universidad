{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id_orden": {
    "type": "integer"
  },
  "clientes": {
    "type": "object",
    "properties": {
      "nombre": {"type": "string"},
      "apellido": {"type": "string"},
      "emailAddress": {"type": "string"},
      "telefono": {"type": "string"}
      },
      "required": ["nombre", "apellido","correo electronico", "telefono"]
  },

  "lista": {
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "producto": {"type": "string"},
        "cantidad": {
          "type": "number",
          "minimum": "0"
        },
        "precio unitario": {
          "type": "number",
          "minimum": "0"
        }
      }
    }
  },

  "direccion": {
    "type": "object",
    "properties":{
      "pais": {"type": "string"},
      "provincia": {"type": "string"},
      "ciudad": {"type": "string"},
      "calle": {"type": "string"},
      "numero": {"type": "integer"},
      "codigo postal": {"type": "integer"}
    },
    "required": ["pais", "provincia", "ciudad", "calle", "codigo postal"]
  },

  "estado": {
    "type": "string",
    "properties":{
      "enum": ["pendiente", "pagado", "enviado", "entregado", "cancelado"]
    }
  }
}
